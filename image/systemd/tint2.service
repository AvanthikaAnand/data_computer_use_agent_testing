[Unit]
Description=Tint2 Panel
After=mutter.service
Requires=dbus-session.service

[Service]
Type=simple
User=agent
Environment=DISPLAY=:1
Environment=HOME=/home/agent
EnvironmentFile=/run/agent/dbus.env
ExecStart=/usr/bin/tint2 -c /home/agent/.config/tint2/tint2rc
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
