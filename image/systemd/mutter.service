[Unit]
Description=Mutter Window Manager
After=dbus-session.service
Requires=dbus-session.service

[Service]
Type=simple
User=agent
Environment=DISPLAY=:1
Environment=HOME=/home/agent
Environment=XDG_SESSION_TYPE=x11
EnvironmentFile=/run/agent/dbus.env
ExecStart=/usr/bin/mutter --replace
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
