<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cu-agent.vpn-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/cu-agent-vpn-monitor.sh</string>
    </array>

    <!-- Start automatically at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it crashes -->
    <key>KeepAlive</key>
    <true/>

    <!-- Log output -->
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/cu-agent-vpn-monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/cu-agent-vpn-monitor.log</string>
</dict>
</plist>
