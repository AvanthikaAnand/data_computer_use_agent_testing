[Unit]
Description=Agent FastAPI Backend
After=network.target dbus.service
Wants=dbus.service

[Service]
Type=simple
User=agent
WorkingDirectory=/home/agent/app
Environment=HOME=/home/agent
Environment=PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/agent.env
ExecStart=/opt/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
