[Unit]
Description=x11vnc VNC Server
After=mutter.service
Requires=xvfb.service

[Service]
Type=simple
User=agent
Environment=DISPLAY=:1
Environment=HOME=/home/agent
ExecStart=/usr/bin/x11vnc \
    -display :1 \
    -nopw \
    -listen localhost \
    -xkb \
    -wait 50 \
    -forever \
    -rfbport 5901 \
    -shared
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
