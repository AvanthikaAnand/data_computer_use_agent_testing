# Copy to .env and fill in your values

# ── Provider ─────────────────────────────────────────────────────────────────
CU_PROVIDER=bedrock          # bedrock | anthropic | ollama | litellm
CU_MODEL=claude-sonnet-3-7   # key from config.yaml models map, or a raw model ID

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Anthropic direct ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── LiteLLM proxy ────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-litellm-local   # change this; gates the /ui dashboard
# Leave LITELLM_API_BASE blank to use the sidecar auto-wired in docker-compose
LITELLM_API_BASE=

# ── Ollama (local models) ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Desktop ───────────────────────────────────────────────────────────────────
WIDTH=1366
HEIGHT=768
