# Copy to /etc/vpn-monitor.env on the EC2 instance and fill in values.
# The systemd service loads this file automatically.

# Path to the .ovpn config file on the host
VPN_CONFIG=/opt/vpn/avanthika.ovpn

# Slack bot token (xoxb-...) with chat:write scope
SLACK_BOT_TOKEN=xoxb-replace-with-your-token

# Slack channel ID to post VPN status messages
SLACK_VPN_CHANNEL=C0B7FUXGHU0

# Seconds between VPN state checks (default: 60)
VPN_CHECK_INTERVAL=60

# URL to ping when connected — keeps the session alive and confirms reachability
VPN_KEEPALIVE_URL=http://yp.internal.you.co/
