[Unit]
Description=Agent Gradio UI
After=agent-api.service
Wants=agent-api.service

[Service]
Type=simple
User=agent
WorkingDirectory=/home/agent/app
Environment=HOME=/home/agent
Environment=PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/agent.env
ExecStart=/opt/venv/bin/python -m ui.app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
